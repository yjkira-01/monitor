<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:CareMonitor.Views">
  <!-- Native WPF templates, informed by Fluent 2's primary / secondary / subtle hierarchy. -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="White"/>
    <Setter Property="Foreground" Value="#294A3F"/>
    <Setter Property="BorderBrush" Value="#D0DCD5"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Margin" Value="0,0,8,4"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="FontSize" Value="13"/><Setter Property="MinWidth" Value="78"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="FocusStroke" CornerRadius="6" Margin="-3" BorderBrush="#639C81" BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
            <Border x:Name="Surface" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Grid x:Name="ContentHost" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Grid.RenderTransform><TranslateTransform Y="0"/></Grid.RenderTransform>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Path x:Name="Glyph" Data="{Binding Path=(v:ButtonAssist.Icon), RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <ContentPresenter Grid.Column="1" ContentSource="Content" RecognizesAccessKey="True" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border x:Name="SelectionBar" Width="3" Height="20" CornerRadius="1.5" Background="#2B7456" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="v:ButtonAssist.Icon" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusStroke" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ContentHost" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
            <Trigger Property="v:ButtonAssist.IsSelected" Value="True"><Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="#F1F6F3"/><Setter Property="BorderBrush" Value="#AABEB1"/></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="#E2ECE5"/><Setter Property="BorderBrush" Value="#8FAF9C"/></MultiTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F0F3F1"/><Setter Property="Foreground" Value="#9BAAA2"/><Setter Property="BorderBrush" Value="#E1E7E3"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#28684D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#205B43"/>
    <Style.Triggers>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="#215B42"/><Setter Property="BorderBrush" Value="#194E37"/></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="#184831"/><Setter Property="BorderBrush" Value="#123D29"/></MultiTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#DBE6DF"/><Setter Property="Foreground" Value="#8C9E93"/><Setter Property="BorderBrush" Value="#DBE6DF"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Subtle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Style.Triggers>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="#E5EEE7"/><Setter Property="BorderBrush" Value="Transparent"/></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="#D6E5DA"/><Setter Property="BorderBrush" Value="Transparent"/></MultiTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Subtle}">
    <Setter Property="Foreground" Value="#A23D39"/>
    <Style.Triggers>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="#F7EAE8"/></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="#F0DAD6"/></MultiTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#AA9E9A"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Subtle}">
    <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Padding" Value="14,12"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="46"/>
    <Setter Property="Foreground" Value="#4C6659"/>
    <Style.Triggers>
      <Trigger Property="v:ButtonAssist.IsSelected" Value="True"><Setter Property="Background" Value="#D8E8DD"/><Setter Property="Foreground" Value="#1C563C"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="v:ButtonAssist.IsSelected" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="#CBDFD2"/></MultiTrigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#BED5C6"/></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
