<Window x:Class="CareMonitor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:CareMonitor.Views" Style="{StaticResource {x:Type Window}}" Title="青禾 · 康养监测" Width="1440" Height="940" MinWidth="1024" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="OnClosing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#ECF2EC" BorderBrush="#DCE6DE" BorderThickness="0,0,1,0">
      <DockPanel Margin="20,28,20,20">
        <StackPanel DockPanel.Dock="Top" Margin="4,0,0,28">
          <StackPanel Orientation="Horizontal"><Image Source="{StaticResource AppMark}" Width="38" Height="38" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="青禾" FontSize="26" FontWeight="SemiBold" Foreground="#28684D"/><TextBlock Text="康养监测" FontSize="10" Foreground="#66766D" Margin="1,1,0,0"/></StackPanel></StackPanel>
          <TextBlock Text="智慧康养管理平台" FontSize="12" Foreground="#607669" Margin="0,18,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#CCD8C3" Margin="0,0,0,18"/><TextBlock Text="青禾康养 · 桌面客户端" FontSize="11"/><TextBlock Text="版本 0.3.2" FontSize="11" Foreground="#66766D" Margin="0,6,0,0"/><TextBlock x:Name="ClockText" FontSize="11" Foreground="#66766D" Margin="0,16,0,0"/></StackPanel>
        <StackPanel x:Name="NavigationPanel"><Button Content="监控中心" v:ButtonAssist.Icon="{StaticResource IconVideo}" Tag="0" Style="{StaticResource Nav}" Click="Navigate"/><Button Content="雷达监测" v:ButtonAssist.Icon="{StaticResource IconPulse}" Tag="1" Style="{StaticResource Nav}" Click="Navigate"/><Button Content="住户管理" v:ButtonAssist.Icon="{StaticResource IconPeople}" Tag="2" Style="{StaticResource Nav}" Click="Navigate"/><Button Content="事件记录" v:ButtonAssist.Icon="{StaticResource IconAlert}" Tag="3" Style="{StaticResource Nav}" Click="Navigate"/><Button Content="健康报告" v:ButtonAssist.Icon="{StaticResource IconDocument}" Tag="4" Style="{StaticResource Nav}" Click="Navigate"/><Button Content="系统设置" v:ButtonAssist.Icon="{StaticResource IconSettings}" Tag="5" Style="{StaticResource Nav}" Click="Navigate"/><Button Content="监测规则" v:ButtonAssist.Icon="{StaticResource IconAlert}" Tag="6" Style="{StaticResource Nav}" Click="Navigate"/><Button Content="双目定位" v:ButtonAssist.Icon="{StaticResource IconVideo}" Tag="7" Style="{StaticResource Nav}" Click="Navigate"/></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,18"><StackPanel><TextBlock x:Name="PageTitle" Text="监控中心" Style="{StaticResource Title}"/><TextBlock x:Name="PageSubtitle" Text="查看监控画面、人员状态和实时告警。" Foreground="#66766D"/></StackPanel><TextBlock x:Name="ModeText" Text="视频未连接" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#28684D" FontWeight="SemiBold"/></Grid>
      <Grid Grid.Row="1">
        <v:StereoPanel x:Name="StereoWorkspace" Visibility="Collapsed"/><Grid x:Name="MonitorPage">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="245"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,14"><Button Content="打开视频" Click="OpenVideo" v:ButtonAssist.Icon="{StaticResource IconFolder}" Style="{StaticResource Primary}"/><Button Content="USB 摄像头" Click="StartCamera" v:ButtonAssist.Icon="{StaticResource IconVideo}"/><Button Content="网络视频" Click="ConnectNetworkVideo" v:ButtonAssist.Icon="{StaticResource IconConnect}"/><Button x:Name="PauseButton" Content="暂停" IsEnabled="False" Click="PauseVideo" v:ButtonAssist.Icon="{StaticResource IconPause}" Style="{StaticResource Subtle}"/><Button Content="停止" Click="StopVideo" v:ButtonAssist.Icon="{StaticResource IconStop}" Style="{StaticResource Subtle}" x:Name="StopButton"/><Button Content="绘制区域" Click="DrawZone" Style="{StaticResource Subtle}"/><Button Content="导出观测" Click="ExportObservations" Style="{StaticResource Subtle}"/><StackPanel><WrapPanel Margin="0,8,0,0"><ComboBox x:Name="CurrentZones" Width="155" DisplayMemberPath="Name" SelectionChanged="SelectCurrentZone" AutomationProperties.Name="当前视频监测区域" Margin="0,0,10,0"/><Button Content="区域设置" Click="EditCurrentZone"/><Button Content="重新框选" Click="RedrawCurrentZone"/><Button Content="删除区域" Click="DeleteCurrentZone" Style="{StaticResource Danger}"/><Button Content="清空当前区域" Click="ClearCurrentZones" Style="{StaticResource Danger}"/><Button x:Name="CancelZoneButton" Content="取消绘制" Click="CancelZone" Style="{StaticResource Subtle}"/></WrapPanel><TextBlock x:Name="ZoneHintText" Foreground="#587362" FontSize="11" Margin="0,7,0,0" Text="区域用于记录进入、离开与停留时间；仅关联当前视频来源。"/></StackPanel></WrapPanel>
          <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><v:VideoView x:Name="VideoCanvas"/><Grid Grid.Row="1" Background="White" Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><TextBlock x:Name="PositionText" Margin="12" Text="00:00" VerticalAlignment="Center"/><Slider x:Name="VideoSeek" AutomationProperties.Name="视频时间轴" Grid.Column="1" Minimum="0" Maximum="1" Margin="0,12" PreviewMouseLeftButtonUp="SeekVideo"/><TextBlock x:Name="DurationText" Grid.Column="2" Text="视频时间" Margin="12" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Grid>
            <Border Grid.Column="1" CornerRadius="6" Background="White" Padding="20" Margin="16,0,0,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="人员状态" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="PeopleCountText" Text="等待人员识别" Foreground="#66766D" Margin="0,7,0,8"/><TextBlock x:Name="CaptureText" FontSize="11" Foreground="#66766D" Margin="0,0,0,14"/><Border Background="#DFE6DC" Height="1"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PeoplePanel" Margin="0,12,0,0"/></ScrollViewer></DockPanel></Border>
          </Grid>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
            <Border Background="White" Padding="12" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="活动分布" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,8"/><TabControl Grid.Row="1" BorderThickness="0"><TabItem Header="人员轨迹"><v:ActivityMapView x:Name="TrajectoryView"/></TabItem><TabItem Header="停留热力"><v:ActivityMapView x:Name="HeatmapView" Heatmap="True"/></TabItem></TabControl><TextBlock Grid.Row="2" Text="相机画面坐标 · 本次监测记录" FontSize="10" Foreground="#66766D" Margin="4,6,0,0"/></Grid></Border>
            <Border Grid.Column="1" Background="White" Padding="18"><DockPanel><TextBlock DockPanel.Dock="Top" Text="活动记录" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/><Button DockPanel.Dock="Bottom" Content="清空本次统计" Click="ResetObservation" Style="{StaticResource Subtle}" HorizontalAlignment="Left" Margin="0,6,0,0"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="ObservationStats" Text="连接视频后开始记录" FontSize="12" Foreground="#28684D"/><TextBlock x:Name="ActivityTimelineText" Margin="0,10,0,0" FontSize="11" Foreground="#66766D"/></StackPanel></ScrollViewer></DockPanel></Border>
            <Border Grid.Column="2" CornerRadius="6" Background="#E7EDE1" Padding="20" Margin="16,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Grid><TextBlock Text="监测结果" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><v:AttentionView x:Name="SceneAttention" Width="44" Height="44" HorizontalAlignment="Right" ToolTip="画面分析关注区域，不代表人员位置"/></Grid><TextBlock x:Name="SceneText" Text="正在分析画面" FontSize="15" FontWeight="Medium" Margin="0,12,0,8"/><TextBlock x:Name="AnalysisSummaryText" FontSize="12" Foreground="#587362"/><Expander Header="分析详情" FontSize="11" Margin="0,12,0,0"><TextBlock x:Name="InferenceText" FontSize="11" Foreground="#587362" Margin="0,8,0,0"/></Expander></StackPanel></ScrollViewer></Border>
          </Grid>
        </Grid>
        <Grid x:Name="RulesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="White" Padding="24" Margin="0,0,0,16"><StackPanel><TextBlock Text="观察与提醒" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="在监控画面点击“绘制区域”，拖动框选床边、门口或重点区域。区域仅关联当前视频来源。" FontSize="12" Foreground="#66766D" Margin="0,10,0,16"/><WrapPanel><TextBlock Text="静止提醒阈值（秒）" VerticalAlignment="Center"/><TextBox x:Name="InactivityThreshold" Width="80" Margin="12,0,20,0" AutomationProperties.Name="长时间静止提醒阈值"/><CheckBox x:Name="SoundAlertChoice" Content="现场提醒播放提示音" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Content="保存规则" Click="SaveRules" Style="{StaticResource Primary}"/></WrapPanel><TextBlock Text="静止根据视频位置变化统计；它不能判断昏迷、呼吸暂停或睡眠。回放提醒单独记录，不播放提示音。" FontSize="11" Foreground="#66766D" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Grid.Row="1" Background="White" Padding="24"><DockPanel><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="监测区域" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Content="修改区域" Click="EditZone" Style="{StaticResource Subtle}"/><Button Content="删除区域" Click="DeleteZone" Style="{StaticResource Subtle}"/></WrapPanel><DataGrid x:Name="ZonesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="区域名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="区域类型" Binding="{Binding Kind}" Width="120"/><DataGridTextColumn Header="停留提醒（秒）" Binding="{Binding DwellSeconds}" Width="140"/><DataGridTextColumn Header="视频来源" Binding="{Binding Source}" Width="2*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
        </Grid>
        <Grid x:Name="RadarPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="230"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18"><StackPanel Orientation="Horizontal"><Button Content="连接雷达" Click="ConnectRadar" v:ButtonAssist.Icon="{StaticResource IconConnect}" Style="{StaticResource Primary}"/><Button Content="断开" Click="DisconnectRadar" v:ButtonAssist.Icon="{StaticResource IconDisconnect}" Style="{StaticResource Subtle}"/><Button Content="回放雷达数据" Click="ReplayRadar" v:ButtonAssist.Icon="{StaticResource IconFolder}"/><ComboBox x:Name="RadarSubjectChoice" AutomationProperties.Name="波形与趋势的雷达目标" Width="110" Margin="10,0,0,0" ToolTip="选择波形与趋势的雷达目标"/></StackPanel><TextBlock x:Name="RadarStatusText" Text="未连接雷达" Foreground="#66766D" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
          <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions><Grid><TabControl Margin="0,48,0,35"><TabItem Header="三维点云"><v:SpatialView x:Name="RadarCloudView"/></TabItem><TabItem Header="空间轨迹与区域"><v:RadarMapView x:Name="RadarMap"/></TabItem><TabItem Header="速度与信号"><DataGrid x:Name="RadarPointsGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="点" Binding="{Binding Index}" Width="45"/><DataGridTextColumn Header="X m" Binding="{Binding X}" Width="*"/><DataGridTextColumn Header="Y m" Binding="{Binding Y}" Width="*"/><DataGridTextColumn Header="Z m" Binding="{Binding Z}" Width="*"/><DataGridTextColumn Header="径向速度 m/s" Binding="{Binding Doppler}" Width="*"/><DataGridTextColumn Header="SNR dB" Binding="{Binding Snr}" Width="*"/></DataGrid.Columns></DataGrid></TabItem></TabControl><Border Background="#F1F5ED" VerticalAlignment="Top" Padding="14,10"><TextBlock x:Name="RadarPresenceText" Text="人员存在：暂无有效数据"/></Border><TextBlock x:Name="RadarDiagnosticText" Text="等待数据接收" FontSize="11" Foreground="#587362" VerticalAlignment="Bottom" Margin="16"/></Grid><Border Grid.Column="1" Background="White" Padding="22" Margin="16,0,0,0"><ScrollViewer><StackPanel x:Name="RadarTargetsPanel"><TextBlock Text="暂无监测数据，请先连接雷达。" Foreground="#66766D"/></StackPanel></ScrollViewer></Border></Grid>
          <Border Grid.Row="2" Background="White" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="心率波形"/><v:WaveView x:Name="HeartWave" Height="135" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="呼吸波形"/><v:WaveView x:Name="BreathWave" Height="135" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="静息记录" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="RestText" Text="暂无静息记录。连接雷达后开始记录体动与生命体征。" Margin="0,12,0,0"/><Button Content="导出体征数据" Click="ExportVitals" Margin="0,16,0,0" v:ButtonAssist.Icon="{StaticResource IconDownload}"/></StackPanel></Grid></Border>
        </Grid>
        <Grid x:Name="ResidentsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><StackPanel Orientation="Horizontal"><Button Content="新增住户" Click="AddResident" v:ButtonAssist.Icon="{StaticResource IconAdd}" Style="{StaticResource Primary}"/><Button Content="编辑档案" Click="EditResident" v:ButtonAssist.Icon="{StaticResource IconEdit}" Style="{StaticResource Subtle}"/><Button Content="删除档案" Click="DeleteResident" v:ButtonAssist.Icon="{StaticResource IconDelete}" Style="{StaticResource Danger}"/></StackPanel><TextBox x:Name="ResidentSearch" AutomationProperties.Name="搜索住户" Width="230" HorizontalAlignment="Right" TextChanged="FilterResidents" ToolTip="搜索姓名、房间或床位"/></DockPanel><DataGrid x:Name="ResidentsGrid" Grid.Row="1" MouseDoubleClick="EditResident"><DataGrid.Columns><DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="140"/><DataGridTextColumn Header="房间" Binding="{Binding Room}" Width="100"/><DataGridTextColumn Header="床位" Binding="{Binding Bed}" Width="100"/><DataGridTextColumn Header="紧急联系人" Binding="{Binding Contact}" Width="190"/><DataGridTextColumn Header="关联设备目标" Binding="{Binding RadarTargetId}" Width="140"/><DataGridTextColumn Header="照护备注" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid></Grid>
        <Grid x:Name="EventsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><StackPanel Orientation="Horizontal"><ComboBox x:Name="EventFilter" AutomationProperties.Name="筛选告警" Width="140" SelectionChanged="FilterEvents"><ComboBoxItem Content="全部记录"/><ComboBoxItem Content="待处理告警"/><ComboBoxItem Content="回放记录"/></ComboBox><Button Content="处理告警" Click="ResolveEvent" Margin="12,0,8,0" v:ButtonAssist.Icon="{StaticResource IconCheck}" Style="{StaticResource Primary}"/><Button Content="导出告警记录" Click="ExportEvents" v:ButtonAssist.Icon="{StaticResource IconDownload}"/><Button Content="定位回放" Click="LocateEvent" v:ButtonAssist.Icon="{StaticResource IconPlay}"/></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="EventsGrid"><DataGrid.Columns><DataGridTextColumn Header="告警时间" Binding="{Binding LocalTime}" Width="150"/><DataGridTextColumn Header="来源" Binding="{Binding Mode}" Width="95"/><DataGridTextColumn Header="人员编号" Binding="{Binding Subject}" Width="105"/><DataGridTextColumn Header="事件内容" Binding="{Binding Kind}" Width="*"/><DataGridTextColumn Header="处理状态" Binding="{Binding Resolution}" Width="100"/><DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="170"/></DataGrid.Columns></DataGrid></Grid>
        <Grid x:Name="ReportsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Button x:Name="LocalReportButton" Content="生成监测报告" Click="GenerateLocal" v:ButtonAssist.Icon="{StaticResource IconDocument}" Style="{StaticResource Primary}"/><Button x:Name="ExternalReportButton" Content="智能分析" Click="GenerateExternal" v:ButtonAssist.Icon="{StaticResource IconSparkle}"/><Button x:Name="CancelReportButton" Content="取消分析" Click="CancelReport" Visibility="Collapsed" Style="{StaticResource Subtle}"/><Button Content="复制正文" Click="CopyReport" Style="{StaticResource Subtle}"/><Button Content="导出报告" Click="ExportReport" v:ButtonAssist.Icon="{StaticResource IconDownload}" Style="{StaticResource Subtle}"/><Button Content="刷新趋势" Click="RefreshTrends" v:ButtonAssist.Icon="{StaticResource IconRefresh}" Style="{StaticResource Subtle}"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E7EDE1" Padding="18" Margin="0,0,16,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="历史报告" FontSize="17" FontWeight="SemiBold"/><ListBox x:Name="ReportsList" Height="180" Margin="0,12,0,16" SelectionChanged="SelectReport" BorderThickness="0" Background="Transparent" DisplayMemberPath="DisplayTitle"/><TextBlock Text="近24小时心率趋势" FontSize="12"/><v:WaveView x:Name="HeartTrend" Height="110" Margin="0,8,0,16"/><TextBlock Text="近24小时呼吸率趋势" FontSize="12"/><v:WaveView x:Name="BreathTrend" Height="110" Margin="0,8,0,16"/></StackPanel><TextBlock Text="智能分析仅发送监测摘要，不上传视频或住户个人信息。" Foreground="#66766D" FontSize="11" VerticalAlignment="Bottom"/></DockPanel></Border><Border Grid.Column="1" Background="White"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="26,18,26,0"><TextBlock x:Name="ReportStatus" Text="选择监测报告或智能分析，汇总当前数据。" TextWrapping="Wrap" Foreground="#28684D"/><TextBlock x:Name="ReportMeta" Margin="0,6,0,12" Foreground="#66766D" FontSize="11"/><Border Height="1" Background="#E3EAE5"/></StackPanel><Expander x:Name="EvidencePanel" DockPanel.Dock="Bottom" Header="查看观测依据" Visibility="Collapsed" Margin="20,6,20,16"><v:ReportView x:Name="ReportEvidence" MaxHeight="220"/></Expander><v:ReportView x:Name="ReportText" AutomationProperties.Name="健康报告正文"/></DockPanel></Border></Grid></Grid>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,20,0"><Border CornerRadius="6" Background="White" Padding="24"><StackPanel><TextBlock Text="摄像头设置" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="视频设备" Style="{StaticResource Label}"/><ComboBox x:Name="CameraChoice" AutomationProperties.Name="USB摄像头设备"/><Button Content="刷新设备" Click="RefreshCameras" Margin="0,10,0,0" v:ButtonAssist.Icon="{StaticResource IconRefresh}" Style="{StaticResource Subtle}"/><TextBlock Text="分辨率与帧率" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><TextBox x:Name="CameraWidth" AutomationProperties.Name="视频宽度" Width="90"/><TextBlock Text=" × " VerticalAlignment="Center"/><TextBox x:Name="CameraHeight" AutomationProperties.Name="视频高度" Width="90"/><TextBox x:Name="CameraFps" AutomationProperties.Name="目标采集帧率" Width="65" Margin="12,0,0,0"/></StackPanel><CheckBox x:Name="ManualExposure" Content="手动调整曝光" Margin="0,18,0,8"/><StackPanel Orientation="Horizontal"><TextBlock Text="曝光" VerticalAlignment="Center"/><TextBox x:Name="Exposure" AutomationProperties.Name="手动曝光值" Width="70" Margin="12,0,20,0"/><CheckBox x:Name="ManualGain" Content="手动增益" VerticalAlignment="Center"/><TextBox x:Name="Gain" AutomationProperties.Name="摄像头增益" Width="70" Margin="12,0,0,0"/></StackPanel><CheckBox x:Name="UseGpu" Content="启用硬件加速（重启后生效）" Margin="0,18,0,0"/><TextBlock Text="识别模型" Style="{StaticResource Label}"/><ComboBox x:Name="ModelProfile" AutomationProperties.Name="识别模型方案"><ComboBoxItem Content="RTMO 多人姿态（实时方案）"/><ComboBoxItem Content="SSD + R3D（原有基线）"/></ComboBox><TextBlock Text="跌倒检测模型" Style="{StaticResource Label}"/><ComboBox x:Name="FallModelChoice" AutomationProperties.Name="跌倒二分类模型"><ComboBoxItem Content="Stage C · 增强二分类"/><ComboBoxItem Content="GMD · 早期跌倒二分类（默认）"/></ComboBox><TextBlock Text="模型设置保存后重启软件生效。" FontSize="11" Foreground="#66766D" Margin="0,8,0,0"/><TextBlock x:Name="ModelDetails" Margin="0,18,0,0" FontSize="11" Foreground="#66766D"/></StackPanel></Border><Border CornerRadius="6" Background="White" Padding="24" Margin="0,18,0,0"><StackPanel><TextBlock Text="雷达设置" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="数据端口与波特率" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="RadarPort" AutomationProperties.Name="雷达数据串口" Width="150"/><TextBox x:Name="RadarBaud" AutomationProperties.Name="数据串口波特率" Width="130" Margin="12,0,0,0"/></StackPanel><TextBlock Text="控制端口（115200）" Style="{StaticResource Label}"/><ComboBox x:Name="RadarControlPort" AutomationProperties.Name="雷达控制串口"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="刷新串口" Click="RefreshPorts" v:ButtonAssist.Icon="{StaticResource IconRefresh}" Style="{StaticResource Subtle}"/><Button Content="导入设备配置" Click="SendRadarConfig" v:ButtonAssist.Icon="{StaticResource IconConnect}"/></StackPanel><TextBlock Text="安装高度 / 水平角 / 俯仰角" Style="{StaticResource Label}"/><WrapPanel><TextBox x:Name="RadarHeight" Width="80" AutomationProperties.Name="雷达安装高度米"/><TextBox x:Name="RadarAzimuth" Width="80" Margin="10,0,0,0" AutomationProperties.Name="雷达水平角度"/><TextBox x:Name="RadarElevation" Width="80" Margin="10,0,0,0" AutomationProperties.Name="雷达俯仰角度"/></WrapPanel><WrapPanel Margin="0,12,0,0"><Button Content="自动识别" Click="DetectRadar" Style="{StaticResource Subtle}"/><Button Content="检查固件" Click="IdentifyRadar" Style="{StaticResource Subtle}"/><Button Content="初始化并连接" Click="InitializeRadar" Style="{StaticResource Primary}"/></WrapPanel><WrapPanel Margin="0,8,0,0"><Button Content="设置空间区域" Click="EditRadarZones" Style="{StaticResource Subtle}"/><Button Content="清空区域" Click="ClearRadarZones" Style="{StaticResource Subtle}"/><Button Content="导出雷达观测" Click="ExportRadar" Style="{StaticResource Subtle}"/></WrapPanel><TextBlock x:Name="RadarSetupText" Text="SR112 / IWR6843AOP 体征与跟踪配置，当前最多一个目标。安装参数请按实际填写。" FontSize="11" Foreground="#66766D" Margin="0,16,0,0"/></StackPanel></Border></StackPanel>
          <StackPanel Grid.Column="1"><Border CornerRadius="6" Background="White" Padding="24"><StackPanel><TextBlock Text="智能分析服务" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="支持远程 API、Ollama 或 LocalAI 本机服务" Foreground="#66766D" Margin="0,6,0,0"/><WrapPanel Margin="0,12,0,0"><Button Content="Ollama 预设" Tag="ollama" Click="ApplyApiPreset" Style="{StaticResource Subtle}"/><Button Content="LocalAI 预设" Tag="localai" Click="ApplyApiPreset" Style="{StaticResource Subtle}"/></WrapPanel><TextBlock Text="服务地址" Style="{StaticResource Label}"/><TextBlock Text="可填写 /v1 地址或完整 /chat/completions 地址" FontSize="11" Foreground="#66766D" Margin="0,0,0,6"/><TextBox x:Name="ApiUrl" AutomationProperties.Name="智能分析服务地址"/><TextBlock Text="分析模型" Style="{StaticResource Label}"/><TextBox x:Name="ApiModel" AutomationProperties.Name="分析模型"/><TextBlock Text="访问密钥（本机服务可不填）" Style="{StaticResource Label}"/><PasswordBox x:Name="ApiKey" AutomationProperties.Name="智能分析访问密钥" Padding="8" MinHeight="36"/><TextBlock x:Name="KeyStatus" FontSize="11" Foreground="#66766D" Margin="0,8,0,0"/><CheckBox x:Name="ClearKey" Content="清除已保存的密钥" Margin="0,12,0,0"/><CheckBox x:Name="AutoReport" Content="自动生成分析报告" Margin="0,18,0,8"/><StackPanel Orientation="Horizontal"><TextBlock Text="生成间隔（秒）" VerticalAlignment="Center"/><TextBox x:Name="ReportInterval" AutomationProperties.Name="定时报告间隔秒" Width="90" Margin="14,0,0,0"/></StackPanel><WrapPanel Margin="0,16,0,0"><Button x:Name="TestApiButton" Content="测试连接" Click="TestApi"/><Button Content="保存分析设置" Click="SaveApiSettings" Style="{StaticResource Primary}"/></WrapPanel><TextBlock x:Name="ApiConnectionStatus" Foreground="#28684D" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="密钥加密保存在本机。开启自动报告后，会按设定间隔调用分析服务。" FontSize="11" Foreground="#66766D" Margin="0,18,0,0"/></StackPanel></Border><Border CornerRadius="6" Background="#E7EDE1" Padding="24" Margin="0,18,0,18"><StackPanel><TextBlock Text="数据与使用说明" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="监测结果用于辅助照护，疑似跌倒需人工核查。回放记录与现场告警分开保存。静息记录不作为睡眠分期或医学诊断。" Margin="0,12,0,0"/><TextBlock x:Name="StorageText" Foreground="#66766D" FontSize="11" Margin="0,14,0,0"/></StackPanel></Border><Button Content="保存设置" HorizontalAlignment="Left" Click="SaveSettings" v:ButtonAssist.Icon="{StaticResource IconSave}" Style="{StaticResource Primary}"/></StackPanel>
        </Grid></ScrollViewer>
      </Grid>
      <Border Grid.Row="2" BorderBrush="#DFE6DC" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,10,0,0"><TextBlock x:Name="StatusText" Text="正在初始化分析服务…" FontSize="11" Foreground="#66766D"/></Border>
    </Grid>
  </Grid>
</Window>
